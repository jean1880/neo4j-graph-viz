# Copy to .env and fill in. .env is git-ignored — never commit real endpoints or credentials.
# In a deployed container these are injected by the orchestrator instead (env / secret).

# --- Connection (required) ---------------------------------------------------------------
# Full URI: bolt://, neo4j://, or neo4j+s:// for TLS (e.g. Aura).
NEO4J_HOST=bolt://localhost:7687
NEO4J_PASSWORD=
# Optional.
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# --- Server ------------------------------------------------------------------------------
# view.sh binds 127.0.0.1; the container image defaults to BIND=0.0.0.0 PORT=8080.
BIND=127.0.0.1
PORT=8901

# --- What to fetch (all optional) ---------------------------------------------------------
# Restrict the fetch to a subset of the database. Empty (the default) means "the whole graph":
# every label, every relationship type. Set these to carve a large graph down to the part you
# actually want to look at — filtering happens in Cypher, so it also cuts the query cost.
# GRAPH_NODE_LABELS=Service,Host,Team
# GRAPH_REL_TYPES=DEPENDS_ON,OWNS

# --- Graph shaping (all optional) --------------------------------------------------------
# Property keys tried in order when choosing a node's display name; the first one a node
# actually has wins. Falls back to the first string property, then to "?".
# GRAPH_NAME_KEYS=name,title,displayName,id,hostname,canonical

# Labels that namespace a node rather than describe it. Dropped when choosing the display
# label; the first one a node carries becomes its `group`. Comma-separated, empty by default.
# GRAPH_WRAPPER_LABELS=Base,Legacy

# Property keys never sent to the browser. Add anything sensitive in your schema — the API is
# unauthenticated, so this list is the last line of defence on what leaves the server.
# GRAPH_SKIP_PROPS=embedding,vector,password,token

# Caps on a single fetch. The viewer renders the whole graph, so these bound both server
# memory and what the browser can realistically lay out. A truncated fetch logs a warning.
# GRAPH_MAX_NODES=10000
# GRAPH_MAX_RELS=20000
# GRAPH_MAX_PROP_CHARS=600

# --- Frontend (build-time) ---------------------------------------------------------------
# Title shown in the tab and the HUD heading.
# VITE_APP_TITLE=Graph Viewer
